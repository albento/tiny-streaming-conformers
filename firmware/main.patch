@@ -3091,6 +3166,186 @@
 
 /* Save recording to SD card */
 
+/* ViT latency: a recording period of the official firmware, with the ViT instead of the WAV file.
+   It stops as a recording does: at the end of the period, on a switch or microphone change, on low supply. */
+
+#define VIT_STACK_PAINT                          0xA5A5A5A5u
+
+extern uint32_t __HeapBase[];
+
+extern uint32_t __StackTop[];
+
+static AM_recordingState_t makeViTLatencyRecording(uint32_t timeOfNextRecording, uint32_t recordDuration, uint32_t *fileOpenTime, uint32_t *fileOpenMilliseconds) {
+
+    /* Microphone, DMA and filter as makeRecording() sets them, with the DC-blocking high-pass only */
+
+    uint32_t effectiveSampleRate = VIT_SAMPLE_RATE / VIT_SAMPLE_RATE_DIVIDER;
+
+    DigitalFilter_designHighPassFilter(effectiveSampleRate, DEFAULT_DC_BLOCKING_FREQ);
+
+    numberOfRawSamplesInDMATransfer = MAXIMUM_SAMPLES_IN_DMA_TRANSFER / VIT_SAMPLE_RATE_DIVIDER;
+
+    while (numberOfRawSamplesInDMATransfer & (numberOfRawSamplesInDMATransfer - 1)) {
+
+        numberOfRawSamplesInDMATransfer = numberOfRawSamplesInDMATransfer & (numberOfRawSamplesInDMATransfer - 1);
+
+    }
+
+    numberOfRawSamplesInDMATransfer *= VIT_SAMPLE_RATE_DIVIDER;
+
+    microphoneChanged = false;
+
+    bool supplyVoltageLow = false;
+
+    AudioMoth_enableExternalSRAM();
+
+    vitAudio[0] = (int16_t*)AM_EXTERNAL_SRAM_START_ADDRESS;
+
+    vitAudio[1] = vitAudio[0] + FRONTEND_BUFFER_SAMPLES;
+
+    AudioMoth_ignoreExternalMicrophone(false);
+
+    AM_gainRange_t gainRange = configSettings->enableLowGainRange ? AM_LOW_GAIN_RANGE : AM_NORMAL_GAIN_RANGE;
+
+    AM_externalMicrophone_t externalMicrophone = AudioMoth_enableMicrophone(gainRange, configSettings->gain, VIT_CLOCK_DIVIDER, VIT_ACQUISITION_CYCLES, VIT_OVERSAMPLE_RATE);
+
+    AudioMoth_initialiseDirectMemoryAccess(primaryBuffer, secondaryBuffer, numberOfRawSamplesInDMATransfer);
+
+    float sampleMultiplier = 16.0f / (float)(VIT_OVERSAMPLE_RATE * VIT_SAMPLE_RATE_DIVIDER);
+
+    if (AudioMoth_hasInvertedOutput()) sampleMultiplier = -sampleMultiplier;
+
+    if (externalMicrophone == AM_EXTERNAL_PRESENT_AND_USED) sampleMultiplier = -sampleMultiplier;
+
+    DigitalFilter_setAdditionalGain(sampleMultiplier);
+
+    /* The CSV file, named like the WAV file would be */
+
+    static char filename[MAXIMUM_FILE_NAME_LENGTH];
+
+    static char foldername[MAXIMUM_FILE_NAME_LENGTH];
+
+    generateFolderAndFilename(foldername, filename, timeOfNextRecording, false);
+
+    char *extension = strstr(filename, ".WAV");
+
+    if (extension) memcpy(extension, ".CSV", 4);
+
+    if (configSettings->enableDailyFolders && AudioMoth_doesDirectoryExist(foldername) == false) FLASH_LED_IF_ENABLED_AND_RETURN_ON_ERROR(AudioMoth_makeDirectory(foldername));
+
+    if (enableLED) AudioMoth_setRedLED(true);
+
+    FLASH_LED_IF_ENABLED_AND_RETURN_ON_ERROR(AudioMoth_openFile(filename));
+
+    AudioMoth_setRedLED(false);
+
+    uint32_t fileOpenMicroseconds;
+
+    AudioMoth_getTimeMicroseconds(fileOpenTime, &fileOpenMicroseconds);
+
+    *fileOpenMilliseconds = ROUNDED_DIV(fileOpenMicroseconds, MICROSECONDS_IN_MILLISECOND);
+
+    static char text[1024];
+
+    uint32_t length = sprintf(text, "# model=%s depth=%d context=%d stem_time_stride=%d sample_rate=%lu clock_hz=%lu\n"
+                                    "buffer_index,frontend_cycles,vit_cycles,isr_cycles,skipped_buffers,tokens_done,frames_done,stack_max_bytes\n",
+                              VIT_MODEL_TAG, VIT_DEPTH, VIT_CONTEXT_SIZE, VIT_STEM_TIME_STRIDE, effectiveSampleRate, SystemCoreClock);
+
+    /* The cycle counter; the RAM between the heap and the stack painted, to find the deepest stack */
+
+    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
+
+    DWT->CYCCNT = 0;
+
+    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
+
+    for (uint32_t *p = __HeapBase; p < (uint32_t*)__get_MSP() - 16; p += 1) *p = VIT_STACK_PAINT;
+
+    static float spectrogram[FRONTEND_NUMBER_OF_FRAMES][FRONTEND_NUMBER_OF_BINS];
+
+    float logits[VIT_N_CLASSES];
+
+    ViTInferenceTiming_t timing;
+
+    Frontend_initialise();
+
+    Frontend_reset(FRONTEND_PCEN_INIT_TRAINING_MEAN);
+
+    ViTInference_reset();
+
+    vitFill = vitIndex = vitBuffersSeen = vitBuffersSkipped = 0;
+
+    vitFull[0] = vitFull[1] = false;
+
+    vitRunning = true;
+
+    AudioMoth_startMicrophoneSamples(VIT_SAMPLE_RATE);
+
+    uint32_t next = 0, row = 0, skippedBefore = 0, buffersInPeriod = recordDuration * effectiveSampleRate / FRONTEND_BUFFER_SAMPLES;
+
+    while (vitBuffersSeen < buffersInPeriod && !microphoneChanged && !switchPositionChanged && !magneticSwitch && !supplyVoltageLow) {
+
+        while (vitFull[next]) {
+
+            vitIsrCycles = 0;
+
+            uint32_t start = DWT->CYCCNT;
+
+            Frontend_computeSpectrogram(vitAudio[next], 1.0f, spectrogram);
+
+            uint32_t frontendEnd = DWT->CYCCNT;
+
+            ViTInference_run(spectrogram, &timing, 0, logits);
+
+            uint32_t vitCycles = DWT->CYCCNT - frontendEnd;
+
+            vitFull[next] = false;
+
+            next ^= 1;
+
+            uint32_t *deepest = __HeapBase;
+
+            while (*deepest == VIT_STACK_PAINT) deepest += 1;
+
+            length += sprintf(text + length, "%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu\n", row, frontendEnd - start, vitCycles, vitIsrCycles,
+                              vitBuffersSkipped - skippedBefore, timing.tokensDone, timing.framesDone,
+                              (uint32_t)((uint8_t*)__StackTop - (uint8_t*)deepest));
+
+            skippedBefore = vitBuffersSkipped;
+
+            row += 1;
+
+            if (length > sizeof(text) - 128) {
+
+                if (enableLED) AudioMoth_setRedLED(true);
+
+                FLASH_LED_IF_ENABLED_AND_RETURN_ON_ERROR(AudioMoth_writeToFile(text, length));
+
+                AudioMoth_setRedLED(false);
+
+                length = 0;
+
+            }
+
+        }
+
+        if (configSettings->enableLowVoltageCutoff && AudioMoth_isSupplyAboveThreshold() == false) supplyVoltageLow = true;
+
+        AudioMoth_sleep();
+
+    }
+
+    vitRunning = false;
+
+    FLASH_LED_IF_ENABLED_AND_RETURN_ON_ERROR(AudioMoth_writeToFile(text, length));
+
+    FLASH_LED_IF_ENABLED_AND_RETURN_ON_ERROR(AudioMoth_closeFile());
+
+    return microphoneChanged ? MICROPHONE_CHANGED : switchPositionChanged ? SWITCH_CHANGED : magneticSwitch ? MAGNETIC_SWITCH :
+           supplyVoltageLow ? SUPPLY_VOLTAGE_LOW : RECORDING_OKAY;
+
+}
