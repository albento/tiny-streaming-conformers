 static int16_t secondaryBuffer[MAXIMUM_SAMPLES_IN_DMA_TRANSFER];
 
+/* ViT latency: 16 kHz whatever the configuration, with the AudioMoth Configuration App's settings for
+   16 kHz (384 kHz sampling divided by 24); the gain and the other settings are the configuration's */
+
+#define VIT_CLOCK_DIVIDER                        4
+#define VIT_ACQUISITION_CYCLES                   16
+#define VIT_OVERSAMPLE_RATE                      1
+#define VIT_SAMPLE_RATE                          384000
+#define VIT_SAMPLE_RATE_DIVIDER                  24
+
+/* ViT latency: the DMA interrupt filters the samples (16 kHz) into two 1024-sample buffers; the main
+   loop runs the front end and the ViT on each full one. A buffer that completes while both are full
+   is skipped (counted), so a slow inference never stalls the acquisition. */
+
+static int16_t *vitAudio[2];           /* in the external SRAM, as the official firmware's recording buffers */
+
+static volatile bool vitRunning, vitFull[2];
+
+static volatile uint32_t vitFill, vitIndex, vitBuffersSeen, vitBuffersSkipped, vitIsrCycles;
+
+static void vitHandleSamples(int16_t *source) {
+
+    uint32_t start = DWT->CYCCNT;
+
+    if (vitFull[vitFill] == false) {
+
+        DigitalFilter_applyFilter(source, vitAudio[vitFill] + vitIndex, VIT_SAMPLE_RATE_DIVIDER, numberOfRawSamplesInDMATransfer);
+
+    }
+
+    vitIndex += numberOfRawSamplesInDMATransfer / VIT_SAMPLE_RATE_DIVIDER;
+
+    if (vitIndex >= FRONTEND_BUFFER_SAMPLES) {
+
+        if (vitFull[vitFill]) {
+
+            vitBuffersSkipped += 1;
+
+        } else {
+
+            vitFull[vitFill] = true;
+
+            vitFill ^= 1;
+
+        }
+
+        vitIndex = 0;
+
+        vitBuffersSeen += 1;
+
+    }
+
+    vitIsrCycles += DWT->CYCCNT - start;
+
+}
