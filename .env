# Where the large folders go. Empty: the default folder inside the repository.
# Absolute paths (or ~/...). A variable set in the shell wins over this file.

# Detection data (prepare_detection.py): SSW and SNE, ~31 GB downloaded, ~64 GB on disk. Default: data/
DATA_DIR=

# Training runs (train.py): weights, scores, INT8 exports, a few GB. Default: runs/
RUNS_DIR=

# Classification data (prepare_classification.py): PolyChirp's raw_dataset/, datasets/ and its audio cache
# (dataset_cache/, 12 GB, written by the first training), ~22 GB.
# Default: inside the submodule, polychirp/raw_dataset/ and polychirp/datasets/
POLYCHIRP_DATA_DIR=
