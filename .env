# Where the large folders go. Empty: the default folder inside the repository.
# Absolute paths (or ~/...). A variable set in the shell wins over this file.

# Classification data (prepare_classification.py): PolyChirp's raw_dataset/, datasets/ and its audio cache
# (dataset_cache/, 12 GB, written by the first training), ~22 GB.
# Default: inside the submodule, polychirp/raw_dataset/ and polychirp/datasets/
CLASSIFICATION_DATA_DIR=

# Detection data (prepare_detection.py): SSW, ~26 GB downloaded, ~57 GB on disk. Default: data/
DETECTION_DATA_DIR=

# Training runs (train.py): weights, scores, INT8 exports, a few GB. Default: runs/
RUNS_DIR=

# --- uv: read from the environment only, so `source env.sh` first (in each shell and job script) ---
# The virtualenv (uv sync, uv run): PyTorch, TensorFlow, CUDA libraries, ~12 GB. Default: .venv/
UV_PROJECT_ENVIRONMENT=
# uv's download cache, ~12 GB too. Default: ~/.cache/uv. On the virtualenv's file system, so that uv
# hard-links the packages into it instead of copying them (twice the space).
UV_CACHE_DIR=
# The Pythons uv installs (uv python install), ~100 MB each. Default: ~/.local/share/uv/python
UV_PYTHON_INSTALL_DIR=
# 1: uv run leaves the virtualenv as it is, e.g. with the V100's PyTorch (README, PyTorch on a V100).
# Default: uv run first syncs the virtualenv to uv.lock
UV_NO_SYNC=
